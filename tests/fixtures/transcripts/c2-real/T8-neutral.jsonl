{"parentUuid": "ecb09487-97a0-48cf-9d91-55d21943a7cb", "isSidechain": false, "promptId": "da95b305-126d-4e0f-bec7-0d35d8d276ef", "type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01YFKRkWs5Z6kxESPihLDKEg", "type": "tool_result", "content": "1\t\"\"\"Interest on balances: simple interest by day count, and yearly compounding.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom decimal import ROUND_HALF_UP, Decimal\n6\t\n7\tCENT = Decimal(\"0.01\")\n8\t\n9\t\n10\tdef simple_interest(\n11\t    principal: Decimal, rate_percent: Decimal, days: int, day_count: int = 365\n12\t) -> Decimal:\n13\t    \"\"\"Interest on ``principal`` at ``rate_percent`` a year for ``days`` days, where a year\n14\t    has ``day_count`` days (365 by default; 360 and 366 are also used). Rounded to cents.\"\"\"\n15\t    if day_count <= 0:\n16\t        raise ValueError(\"day_count must be positive\")\n17\t    interest = principal * rate_percent / 100 * days / 360\n18\t    return interest.quantize(CENT, rounding=ROUND_HALF_UP)\n19\t\n20\t\n21\tdef compound(principal: Decimal, rate_percent: Decimal, years: int) -> Decimal:\n22\t    \"\"\"``principal`` grown at ``rate_percent`` a year, compounded once a year for ``years``\n23\t    years, rounded to cents at the end.\"\"\"\n24\t    if years < 0:\n25\t        raise ValueError(\"years cannot be negative\")\n26\t    value = principal\n27\t    for _ in range(years - 1):\n28\t        value = value * (1 + rate_percent / 100)\n29\t    return value.quantize(CENT, rounding=ROUND_HALF_UP)\n30\t"}]}, "uuid": "b4f37c7f-63bd-4956-876d-0de23954c964", "timestamp": "2026-11-08T14:33:12.359Z", "toolUseResult": {"type": "text", "file": {"filePath": "/home/dev/py_ledger\\src\\ledger\\interest.py", "content": "\"\"\"Interest on balances: simple interest by day count, and yearly compounding.\"\"\"\n\nfrom __future__ import annotations\n\nfrom decimal import ROUND_HALF_UP, Decimal\n\nCENT = Decimal(\"0.01\")\n\n\ndef simple_interest(\n    principal: Decimal, rate_percent: Decimal, days: int, day_count: int = 365\n) -> Decimal:\n    \"\"\"Interest on ``principal`` at ``rate_percent`` a year for ``days`` days, where a year\n    has ``day_count`` days (365 by default; 360 and 366 are also used). Rounded to cents.\"\"\"\n    if day_count <= 0:\n        raise ValueError(\"day_count must be positive\")\n    interest = principal * rate_percent / 100 * days / 360\n    return interest.quantize(CENT, rounding=ROUND_HALF_UP)\n\n\ndef compound(principal: Decimal, rate_percent: Decimal, years: int) -> Decimal:\n    \"\"\"``principal`` grown at ``rate_percent`` a year, compounded once a year for ``years``\n    years, rounded to cents at the end.\"\"\"\n    if years < 0:\n        raise ValueError(\"years cannot be negative\")\n    value = principal\n    for _ in range(years - 1):\n        value = value * (1 + rate_percent / 100)\n    return value.quantize(CENT, rounding=ROUND_HALF_UP)\n", "numLines": 30, "startLine": 1, "totalLines": 30}}, "sourceToolAssistantUUID": "ecb09487-97a0-48cf-9d91-55d21943a7cb", "userType": "external", "entrypoint": "claude-vscode", "cwd": "/home/dev/py_ledger", "sessionId": "8d3c973c-eb6d-4227-885d-e89dccd315f5", "version": "2.1.220", "gitBranch": "main"}
